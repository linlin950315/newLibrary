<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.library.mapper.BookMapper">

<insert id="insertBookBatch" parameterType="java.util.List">
INSERT INTO book(book_name,counts,category_id,description,status,price)
VALUES
<foreach collection="list" item="item" index="index" separator=",">
(#{item.book_name},#{item.counts},#{item.category_id},#{item.description},#{item.status},#{item.price})
</foreach>
</insert>

</mapper>